{
  "expo": {
    "name": "\u200B",
    "slug": "10in",
    "scheme": "10in",
    "version": "0.1.0",
    "icon": "./src/assets/images/app-logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/images/app-logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF6"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/app-logo-transparent.png",
        "backgroundColor": "#FAFAF6"
      }
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ],
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez 10in à accéder à vos photos pour choisir une photo de profil.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
