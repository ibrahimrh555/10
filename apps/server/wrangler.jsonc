{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "10in-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "PROFILE_PHOTOS",
      "bucket_name": "10in-profile-photos"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
